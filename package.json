{
  "name": "longball",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:android": "bash scripts/setup-android.sh",
    "dev": "bash scripts/start-mobile.sh",
    "dev:web": "bash scripts/start-web.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter mobile typecheck",
    "test:unit": "vitest run",
    "test:integration": "vitest run apps/mobile/src/platform",
    "test:e2e": "node scripts/browser-review.mjs",
    "package:review": "pnpm build:web && python3 scripts/package-review.py",
    "test:contracts": ".venv/bin/python scripts/validate-contracts.py",
    "test:preview": "python3 scripts/test-cloud-source-publication.py",
    "fixtures:synthetic": "tsx scripts/synthetic-fixtures.ts",
    "mobile:config": "pnpm --filter mobile exec expo config --type prebuild",
    "build": "pnpm --filter mobile build:bundle",
    "build:web": "pnpm --filter mobile build:web",
    "build:api": "node scripts/build-api.mjs",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "test:api": "vitest run --config apps/api/vitest.config.ts",
    "test:access": "vitest run --config apps/api/vitest.config.ts packages/application/src/access.test.ts apps/api/src/oidc.test.ts",
    "test:migration": "vitest run --config apps/api/vitest.config.ts apps/api/src/server.test.ts -t 'restor|migrat|rolls back'",
    "preview:web": "python3 -m http.server 4173 --bind 0.0.0.0 --directory apps/mobile/dist-web",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:api && pnpm test:contracts && pnpm test:preview && pnpm fixtures:synthetic && pnpm build && pnpm build:api",
    "db:migrate:check": "node scripts/check-migrations.mjs",
    "quality:inventory": "node scripts/quality-inventory.mjs",
    "quality:secrets": "node scripts/check-secrets.mjs",
    "quality:dependencies": "node scripts/check-dependencies.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "expo-doctor": "1.21.5",
    "pdf-lib": "1.17.1",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
