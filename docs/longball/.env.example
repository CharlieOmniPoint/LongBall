# LongBall proposed configuration names. No working credentials or deployment.
# Split client and server environments in the implementation.

# Client public values. Every EXPO_PUBLIC value is visible in the app binary.
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid/v1
EXPO_PUBLIC_OIDC_ISSUER=https://identity.example.invalid/realms/longball-development
EXPO_PUBLIC_OIDC_CLIENT_ID=longball-mobile

# Server only. Inject values from the approved secret store.
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
IDENTITY_ADMIN_CLIENT_ID=
IDENTITY_ADMIN_CLIENT_SECRET=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
CONTROLLER_GRANT_SIGNING_KEY=
PUSH_PROVIDER_CREDENTIALS=
EMAIL_PROVIDER_API_KEY=
MONITORING_EXPORT_SECRET=

# Explicit environment policy references; unconfigured real-data policy fails closed.
APP_ENVIRONMENT=development
CLUB_TIME_ZONE=Europe/London
PUBLICATION_POLICY_VERSION=
RETENTION_POLICY_VERSION=
APPROVED_OFFLINE_GRANT_POLICY_VERSION=
