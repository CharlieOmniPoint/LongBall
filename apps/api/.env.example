# Fictional local integration only; synthetic authentication is forbidden in production.
LONGBALL_SYNTHETIC_AUTH=0
# Optional generated-demo score/vote/gallery scenario; requires synthetic auth and refuses production.
LONGBALL_DEMO_SCENARIO=0
LONGBALL_API_HOST=127.0.0.1
LONGBALL_API_PORT=4310
LONGBALL_API_DATABASE=.local/api/longball.sqlite
# Real runtime uses PostgreSQL. Prefer mounted URL files; never supply both forms.
LONGBALL_DATABASE_URL_FILE=
LONGBALL_DATABASE_MIGRATION_MODE=verify
# Dedicated migration command receives its own schema-owner URL, never API credentials.
LONGBALL_MIGRATION_DATABASE_URL_FILE=
LONGBALL_STATIC_DIRECTORY=
LONGBALL_API_ORIGINS=
# Explicit trusted HTTPS provider values; no provider has been provisioned.
LONGBALL_OIDC_ISSUER=https://identity.example.invalid/realms/longball
LONGBALL_OIDC_AUDIENCE=longball-api
LONGBALL_OIDC_JWKS_URI=https://identity.example.invalid/realms/longball/protocol/openid-connect/certs
# Approved provider ACR values that establish stronger authentication, if used.
LONGBALL_OIDC_MFA_ACR=
# Additional explicit HTTPS origins when provider token endpoints use a different host.
LONGBALL_OIDC_CONNECT_ORIGINS=
# Private local object directory; never place inside the browser static export.
LONGBALL_MEDIA_DIRECTORY=.local/api/media
# Optional maintained ClamAV executable, absolute path. No scanner means completion fails closed.
LONGBALL_CLAMSCAN_PATH=
# Prefer a maintained private clamd with its signed database loaded once.
# Configure exactly one socket or host+port endpoint. No scanner means fail-closed completion.
LONGBALL_CLAMD_SOCKET=
LONGBALL_CLAMD_HOST=
LONGBALL_CLAMD_PORT=
# Optional explicit fictional trial only, rejected in NODE_ENV=production.
# JSON must supply every TrustedTimePolicy field; there is no guessed production bound.
LONGBALL_FICTIONAL_CLOCK_POLICY=
