{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start:dev-client": "expo start --dev-client --localhost",
    "start:web": "expo start --web --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --no-install",
    "typecheck": "tsc --noEmit",
    "build:bundle": "expo export --platform android --platform ios --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@longball/domain": "workspace:*",
    "@longball/testing": "workspace:*",
    "expo": "58.0.16",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-notifications": "58.1.5",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
